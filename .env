# Flask Application Configuration (需要FLASK_前缀)
FLASK_ENV=prod
FLASK_DEBUG=True
FLASK_SQLALCHEMY_DATABASE_URI=sqlite:///chat_app.sqlite3
FLASK_SQLALCHEMY_TRACK_MODIFICATIONS=True
FLASK_UPLOAD_FOLDER=static/upload
FLASK_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,bmp,webp
FLASK_MAX_CONTENT_LENGTH=16777216

# Gunicorn Configuration
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=gevent
GUNICORN_WORKER_CONNECTIONS=50
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_KEYFILE=deepspring-tech.com.key
GUNICORN_CERTFILE=deepspring-tech.com.pem
GUNICORN_TIMEOUT=120

# SSL Certificate Files (for production)
SSL_KEY_FILE=deepspring-tech.com.key
SSL_CERT_FILE=deepspring-tech.com.pem